{
  "name": "simple-experiment",
  "displayName": "SimpleExperiment",
  "description": "面向科研实验的后台 SSH 隧道实时集群编排面板。",
  "version": "0.5.432",
  "publisher": "simple-local",
  "extensionKind": [
    "ui"
  ],
  "extensionDependencies": [
    "simple-local.simple-sftp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zlinkw/SimpleExperiment.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:simpleExperiment.panel",
    "onCommand:simpleExperiment.openPanel",
    "onCommand:simpleExperiment.copyPanelDiagnostics",
    "onCommand:simpleExperiment.showOperationLog",
    "onCommand:simpleExperiment.restorePanel",
    "onCommand:simpleExperiment.quickSetup",
    "onCommand:simpleExperiment.bootstrapProject",
    "onCommand:simpleExperiment.prepareAgents",
    "onCommand:simpleExperiment.openSetupGuide",
    "onCommand:simpleExperiment.configureXshellSavedSessions",
    "onCommand:simpleExperiment.writeXshellAgentStartupCommands",
    "onCommand:simpleExperiment.configureWorkerTunnels",
    "onCommand:simpleExperiment.configureTunnelPorts",
    "onCommand:simpleExperiment.configureXshellRealtimeTunnel",
    "onCommand:simpleExperiment.startWorkerTunnel",
    "onCommand:simpleExperiment.startAllXshellRealtimeTunnels",
    "onCommand:simpleExperiment.startAllXshellConnections",
    "onCommand:simpleExperiment.openXshellSessions",
    "onCommand:simpleExperiment.testAllTunnels",
    "onCommand:simpleExperiment.showTunnelEndpointRegistry",
    "onCommand:simpleExperiment.testXshellTunnel",
    "onCommand:simpleExperiment.restartRealtimeStream",
    "onCommand:simpleExperiment.pauseRealtimeStream",
    "onCommand:simpleExperiment.resumeRealtimeStream",
    "onCommand:simpleExperiment.pauseAllNetworkActivity",
    "onCommand:simpleExperiment.generateXshellTunnelScript",
    "onCommand:simpleExperiment.openTunnelStatus",
    "onCommand:simpleExperiment.runXshellRealIntegrationCheck",
    "onCommand:simpleExperiment.manualRefresh",
    "onCommand:simpleExperiment.importOfflineBundle",
    "onCommand:simpleExperiment.openLastCheckStaticReport",
    "onCommand:simpleExperiment.copyLastCheckStaticReport",
    "onCommand:simpleExperiment.runCheckStatic",
    "onCommand:simpleExperiment.setupGitBackup",
    "onCommand:simpleExperiment.removeGitBackup",
    "onCommand:simpleExperiment.showGitBackupStatus",
    "onCommand:simpleExperiment.syncToGitHub",
    "onCommand:simpleExperiment.publishToGitHub"
  ],
  "main": "./dist/updates/Bootstrap.js",
  "bin": {
    "simpleex": "./bin/simpleex.cjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "simpleExperiment.checkPluginUpdates",
        "title": "SimpleExperiment：检查配套插件更新"
      },
      {
        "command": "simpleExperiment.installPluginUpdates",
        "title": "SimpleExperiment：安装或补装配套更新并重载"
      },
      {
        "command": "simpleExperiment.syncToGitHub",
        "title": "SimpleExperiment：同步到 GitHub",
        "icon": "$(repo-push)"
      },
      {
        "command": "simpleExperiment.publishToGitHub",
        "title": "SimpleExperiment：发布到 GitHub",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "simpleExperiment.setupGitBackup",
        "title": "SimpleExperiment：配置提交自动备份",
        "icon": "$(settings-gear)"
      },
      {
        "command": "simpleExperiment.removeGitBackup",
        "title": "SimpleExperiment：移除提交自动备份",
        "icon": "$(trash)"
      },
      {
        "command": "simpleExperiment.showGitBackupStatus",
        "title": "SimpleExperiment：查看备份状态",
        "icon": "$(info)"
      },
      {
        "command": "simpleExperiment.openPanel",
        "title": "SimpleExperiment：打开面板",
        "icon": "$(server-environment)"
      },
      {
        "command": "simpleExperiment.copyPanelDiagnostics",
        "title": "SimpleExperiment：复制 Panel 诊断",
        "icon": "$(copy)"
      },
      {
        "command": "simpleExperiment.showOperationLog",
        "title": "SimpleExperiment：查看操作完整日志",
        "icon": "$(output)"
      },
      {
        "command": "simpleExperiment.restorePanel",
        "title": "SimpleExperiment：恢复 Panel",
        "icon": "$(refresh)"
      },
      {
        "command": "simpleExperiment.quickSetup",
        "title": "SimpleExperiment：检查服务器配置",
        "icon": "$(wand)"
      },
      {
        "command": "simpleExperiment.bootstrapProject",
        "title": "SimpleExperiment：识别工作区",
        "icon": "$(rocket)"
      },
      {
        "command": "simpleExperiment.prepareAgents",
        "title": "SimpleExperiment：准备 Agent 并启动",
        "icon": "$(server-process)"
      },
      {
        "command": "simpleExperiment.openSetupGuide",
        "title": "SimpleExperiment：打开配置说明",
        "icon": "$(book)"
      },
      {
        "command": "simpleExperiment.configureXshellSavedSessions",
        "title": "SimpleExperiment：配置 Xshell 会话文件",
        "icon": "$(bookmark)"
      },
      {
        "command": "simpleExperiment.writeXshellAgentStartupCommands",
        "title": "SimpleExperiment：写入 Agent 自启动 RemoteCommand",
        "icon": "$(edit)"
      },
      {
        "command": "simpleExperiment.configureWorkerTunnels",
        "title": "SimpleExperiment：配置 Worker 隧道",
        "icon": "$(server-process)"
      },
      {
        "command": "simpleExperiment.configureTunnelPorts",
        "title": "SimpleExperiment：配置隧道端口",
        "icon": "$(ports-view-icon)"
      },
      {
        "command": "simpleExperiment.configureXshellRealtimeTunnel",
        "title": "SimpleExperiment：旧自动隧道配置（不推荐）",
        "icon": "$(settings-gear)"
      },
      {
        "command": "simpleExperiment.startWorkerTunnel",
        "title": "SimpleExperiment：启动 Worker 隧道",
        "icon": "$(debug-start)"
      },
      {
        "command": "simpleExperiment.startAllXshellRealtimeTunnels",
        "title": "SimpleExperiment：启动全部后台隧道",
        "icon": "$(run-all)"
      },
      {
        "command": "simpleExperiment.startAllXshellConnections",
        "title": "SimpleExperiment：启动全部后台连接",
        "icon": "$(run-all)"
      },
      {
        "command": "simpleExperiment.openXshellSessions",
        "title": "SimpleExperiment：一键打开 Xshell",
        "icon": "$(terminal)"
      },
      {
        "command": "simpleExperiment.testAllTunnels",
        "title": "SimpleExperiment：检测全部隧道",
        "icon": "$(pulse)"
      },
      {
        "command": "simpleExperiment.showTunnelEndpointRegistry",
        "title": "SimpleExperiment：显示隧道端点清单",
        "icon": "$(list-tree)"
      },
      {
        "command": "simpleExperiment.testXshellTunnel",
        "title": "SimpleExperiment：检测 Xshell 隧道",
        "icon": "$(pulse)"
      },
      {
        "command": "simpleExperiment.restartRealtimeStream",
        "title": "SimpleExperiment：重启实时流",
        "icon": "$(debug-restart)"
      },
      {
        "command": "simpleExperiment.pauseRealtimeStream",
        "title": "SimpleExperiment：暂停实时流",
        "icon": "$(debug-pause)"
      },
      {
        "command": "simpleExperiment.resumeRealtimeStream",
        "title": "SimpleExperiment：恢复实时流",
        "icon": "$(debug-continue)"
      },
      {
        "command": "simpleExperiment.pauseAllNetworkActivity",
        "title": "SimpleExperiment：暂停全部网络活动",
        "icon": "$(circle-slash)"
      },
      {
        "command": "simpleExperiment.generateXshellTunnelScript",
        "title": "SimpleExperiment：生成 Xshell 会话启动脚本",
        "icon": "$(file-code)"
      },
      {
        "command": "simpleExperiment.openTunnelStatus",
        "title": "SimpleExperiment：打开隧道状态",
        "icon": "$(json)"
      },
      {
        "command": "simpleExperiment.runXshellRealIntegrationCheck",
        "title": "SimpleExperiment：运行 Xshell 真实对接检测",
        "icon": "$(checklist)"
      },
      {
        "command": "simpleExperiment.manualRefresh",
        "title": "SimpleExperiment：手动快照",
        "icon": "$(refresh)"
      },
      {
        "command": "simpleExperiment.importOfflineBundle",
        "title": "SimpleExperiment：导入离线包",
        "icon": "$(archive)"
      },
      {
        "command": "simpleExperiment.clearCache",
        "title": "SimpleExperiment：清除缓存",
        "icon": "$(trash)"
      },
      {
        "command": "simpleExperiment.verifyAgentVersion",
        "title": "SimpleExperiment：校验 Agent 版本",
        "icon": "$(check)"
      },
      {
        "command": "simpleExperiment.openLastCheckStaticReport",
        "title": "SimpleExperiment：打开静态检查报告",
        "icon": "$(file)"
      },
      {
        "command": "simpleExperiment.copyLastCheckStaticReport",
        "title": "SimpleExperiment：复制静态检查报告",
        "icon": "$(copy)"
      },
      {
        "command": "simpleExperiment.runCheckStatic",
        "title": "SimpleExperiment：检查项目接入",
        "icon": "$(checklist)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "simpleExperiment.writeXshellAgentStartupCommands",
          "when": "config.simpleExperiment.showAdvancedCommands"
        },
        {
          "command": "simpleExperiment.configureXshellRealtimeTunnel",
          "when": "config.simpleExperiment.showAdvancedCommands"
        },
        {
          "command": "simpleExperiment.startWorkerTunnel",
          "when": "config.simpleExperiment.showAdvancedCommands"
        },
        {
          "command": "simpleExperiment.startAllXshellRealtimeTunnels",
          "when": "config.simpleExperiment.showAdvancedCommands"
        },
        {
          "command": "simpleExperiment.showTunnelEndpointRegistry",
          "when": "config.simpleExperiment.showAdvancedCommands"
        },
        {
          "command": "simpleExperiment.testXshellTunnel",
          "when": "config.simpleExperiment.showAdvancedCommands"
        },
        {
          "command": "simpleExperiment.restartRealtimeStream",
          "when": "config.simpleExperiment.showAdvancedCommands"
        },
        {
          "command": "simpleExperiment.pauseRealtimeStream",
          "when": "config.simpleExperiment.showAdvancedCommands"
        },
        {
          "command": "simpleExperiment.resumeRealtimeStream",
          "when": "config.simpleExperiment.showAdvancedCommands"
        },
        {
          "command": "simpleExperiment.pauseAllNetworkActivity",
          "when": "config.simpleExperiment.showAdvancedCommands"
        },
        {
          "command": "simpleExperiment.generateXshellTunnelScript",
          "when": "config.simpleExperiment.showAdvancedCommands"
        },
        {
          "command": "simpleExperiment.openTunnelStatus",
          "when": "config.simpleExperiment.showAdvancedCommands"
        },
        {
          "command": "simpleExperiment.runXshellRealIntegrationCheck",
          "when": "config.simpleExperiment.showAdvancedCommands"
        },
        {
          "command": "simpleExperiment.manualRefresh",
          "when": "config.simpleExperiment.showAdvancedCommands"
        },
        {
          "command": "simpleExperiment.importOfflineBundle",
          "when": "config.simpleExperiment.showAdvancedCommands"
        }
      ]
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "simpleExperiment",
          "title": "SimpleExperiment",
          "icon": "$(server-environment)"
        }
      ]
    },
    "views": {
      "simpleExperiment": [
        {
          "type": "webview",
          "id": "simpleExperiment.panel",
          "name": "集群",
          "icon": "$(server-environment)"
        }
      ]
    },
    "configuration": {
      "title": "SimpleExperiment",
      "properties": {
        "simpleExperiment.panel.retainContextWhenHidden": {
          "type": "boolean",
          "default": false,
          "description": "隐藏 SimpleExperiment 面板时保留整个 Webview 上下文会增加长期内存占用。默认隐藏后释放上下文，并在重新显示时恢复轻量界面状态；仅在需要隐藏期间保持页面运行时启用。"
        },
        "simpleExperiment.gitBackup.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用提交自动备份：打开项目时自动安装 post-commit hook，提交后推送当前分支到远程。"
        },
        "simpleExperiment.gitBackup.remote": {
          "type": "string",
          "default": "origin",
          "description": "自动备份使用的 git remote 名称。"
        },
        "simpleExperiment.gitBackup.verifyRemoteAccess": {
          "type": "boolean",
          "default": true,
          "description": "安装前校验远程可达性与推送凭据；校验失败时不写入 hook。"
        },
        "simpleExperiment.topologyMode": {
          "type": "string",
          "default": "worker_pool",
          "enum": [
            "worker_pool"
          ],
          "enumDescriptions": [
            "统一 Worker 流程，支持一台或多台服务器。"
          ],
          "scope": "resource",
          "description": "当前项目的服务器拓扑。模式与启用端点数量不一致时阻止新运行；模式切换不会迁移已有任务或结果。"
        },
        "simpleExperiment.workspaceHostRoot": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "可选 Windows 宿主工作区根目录。仅用于将 Dev Container 工作区映射到 UI Extension Host；普通 Windows 工作区无需配置。"
        },
        "simpleExperiment.workspaceContainerRoot": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "可选 Dev Container 工作区根目录，例如 /workspaces。远程工作区副作用操作必须同时配置宿主根。"
        },
        "simpleExperiment.showAdvancedCommands": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "在命令面板中显示旧兼容、单端点、实时流和诊断恢复命令。关闭时不删除命令或面板入口。"
        },
        "simpleExperiment.planDir": {
          "type": "string",
          "default": "experiments/plans",
          "scope": "resource",
          "description": "相对于工作区根目录的实验计划目录。"
        },
        "simpleExperiment.results.planOutputRetention": {
          "type": "string",
          "enum": [
            "latest-only"
          ],
          "default": "latest-only",
          "scope": "resource",
          "description": "产物只保留每个任务最新一轮，重跑前按两次确认删除精确旧目录；不生成 attempt、历史产物版本或 clean_dir 备份。旧设置值按本策略兼容读取，不自动清扫声明范围外的历史文件。"
        },
        "simpleExperiment.codeSync.includePaths": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "scope": "resource",
          "description": "旧版额外上传路径；首次打开同步范围树时自动纳入选择。"
        },
        "simpleExperiment.codeSync.scopePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "scope": "resource",
          "description": "本机与服务器同步的完整项目相对路径范围；未设置时默认非产物、非预训练权重目录。"
        },
        "simpleExperiment.serverSync.paths": {
          "type": "array",
          "default": [
            "."
          ],
          "items": {
            "type": "string"
          },
          "scope": "resource",
          "description": "Worker 之间的同步范围。默认整个项目，包含完整 work_dirs（兼容 work_dir）；不沿用本机代码同步的产物排除。每个 job 完成后，只同步本任务产物与当前勾选范围的交集到所有已启用 Worker。"
        },
        "simpleExperiment.remote.allowedRoots": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "scope": "resource",
          "description": "可选的远端项目父目录允许前缀。留空表示不按服务器名限制；配置后每个 Worker 必须使用列表内根目录或其子目录。"
        },
        "simpleExperiment.remote.deniedRoots": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "scope": "resource",
          "description": "禁止用作远端项目父目录的前缀。用户配置优先于内置推断；此列表只做额外安全边界，不提供任何默认服务器路径。"
        },
        "simpleExperiment.resultCsvDir": {
          "type": "string",
          "default": "experiments/results",
          "scope": "resource",
          "description": "相对于工作区根目录的实验结果 CSV 默认目录。新 Plan 和未显式声明结果路径的任务使用此目录；已有 Plan 的显式结果路径优先。"
        },
        "simpleExperiment.projectAdapterRules": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "description": "当前工作区的结果捕获规则、指标别名及 CSV 列映射。通过 SimpleExperiment 面板交互式维护；插件同步到 Agent 自有状态目录，不要求项目存在 experiments/simple_project.yaml。"
        },
        "simpleExperiment.connectionMode": {
          "type": "string",
          "default": "xshell_tunnel_realtime",
          "enum": [
            "xshell_tunnel_realtime",
            "offline_import"
          ],
          "scope": "application",
          "description": "连接模式。Xshell 实时隧道模式只访问 127.0.0.1 本地端点。"
        },
        "simpleExperiment.tunnel.localForwardPort": {
          "type": "number",
          "default": 18765,
          "minimum": 1024,
          "maximum": 65535,
          "scope": "application",
          "description": "Xshell 会话在 127.0.0.1 上监听的本地转发端口。"
        },
        "simpleExperiment.tunnel.remoteAgentPort": {
          "type": "number",
          "default": 18765,
          "minimum": 1024,
          "maximum": 65535,
          "scope": "application",
          "description": "Worker Agent 监听的服务端口；每台服务器的端点配置优先。"
        },
        "simpleExperiment.tunnel.agentToken": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "可选的 Worker Agent token。诊断信息会自动脱敏。"
        },
        "simpleExperiment.tunnel.remoteTmuxSessionPrefix": {
          "type": "string",
          "default": "simple",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$",
          "scope": "application",
          "description": "远端 tmux 会话名前缀，用于多用户共用服务器时区分归属；仅允许小写字母、数字、点、下划线和连字符。"
        },
        "simpleExperiment.tensorboard.port": {
          "type": "number",
          "default": 6006,
          "minimum": 1024,
          "maximum": 65535,
          "scope": "application",
          "description": "TensorBoard 在远端监听的端口，点击“打开 TensorBoard”时会重启该端口上的 <prefix>_tb tmux 会话。"
        },
        "simpleExperiment.tensorboard.logdir": {
          "type": "string",
          "default": "work_dirs",
          "scope": "application",
          "description": "启动 TensorBoard 时优先使用的日志目录（相对于远端项目根目录）。留空或不存在时，agent 会自动探测 events.out.tfevents.* 目录并直接启动 tensorboard。"
        },
        "simpleExperiment.tensorboard.tmuxSession": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "TensorBoard 的 tmux 会话名。留空时自动取 <tunnel.remoteTmuxSessionPrefix>_tb，切勿写死具体服务器或用户名。"
        },
        "simpleExperiment.tunnel.condaEnv": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "远端 Agent 和计划任务使用的 Conda 环境。必须为绝对路径（精确到环境文件夹，如 /data/<user>/conda_envs/<env_name> 或 /usr/local/anaconda3/envs/<env_name>，可选以 /bin/python 结尾，以 / 开头）；留空时不激活 Conda，使用系统 Python。仅环境名（如 <env_name>）已废弃，请填写完整环境路径。"
        },
        "simpleExperiment.tunnel.workerTunnels": {
          "type": "array",
          "default": [],
          "scope": "application",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "displayName": {
                "type": "string"
              },
              "localForwardPort": {
                "type": "number"
              },
              "remoteAgentPort": {
                "type": "number"
              },
              "sshConfigAlias": {
                "type": "string"
              },
              "maxConcurrentGpus": {
                "type": [
                  "number",
                  "string"
                ],
                "default": "auto",
                "deprecationMessage": "已弃用：使用自动识别卡数、每卡并行配额和总剩余显存门槛。"
              },
              "privateKeyPath": {
                "type": "string"
              },
              "authMethod": {
                "type": "string",
                "enum": [
                  "password",
                  "key",
                  "auto"
                ]
              },
              "enabled": {
                "type": "boolean"
              },
              "gpuIdleUtilThreshold": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "deprecationMessage": "已弃用：使用自动识别卡数、每卡并行配额和总剩余显存门槛。"
              },
              "gpuIdleMemThresholdMb": {
                "type": "number",
                "minimum": 0,
                "maximum": 8192,
                "deprecationMessage": "已弃用：使用自动识别卡数、每卡并行配额和总剩余显存门槛。"
              },
              "sessionCheckMinSeconds": {
                "type": "number",
                "minimum": 1,
                "maximum": 60
              },
              "workerStatusTtlSeconds": {
                "type": "number",
                "minimum": 10,
                "maximum": 7200
              },
              "agentLoginPolicy": {
                "type": "string",
                "enum": [
                  "preserve",
                  "managed"
                ],
                "default": "preserve"
              },
              "workerHost": {
                "type": "string"
              },
              "workerUser": {
                "type": "string"
              },
              "workerSshPort": {
                "type": "number"
              },
              "gpuMemoryRatioEnabled": {
                "type": "boolean",
                "description": "本 Worker 覆盖设置，未设置时跟随全局。按显存比例设置每张卡的自动任务上限。关闭时保持一卡一个自动任务；手动派发不受此上限限制。需要支持该功能的 Worker Agent 和 Scheduler。",
